# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list. Mobile apps don't send Origin, so this only matters for the future admin panel.
CORS_ORIGINS=http://localhost:3000

# ─── Database (Supabase) ────────────────────────────────────
# App traffic → Supavisor TRANSACTION pooler (port 6543).
# Supabase Dashboard → Connect → "Transaction pooler".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Migrations → Supavisor SESSION pooler (port 5432, same host).
# Do NOT use db.<ref>.supabase.co here: that direct host is IPv6-only and Render has no IPv6 egress.
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Max connections this process opens to the transaction pooler.
DB_POOL_MAX=10

# ─── Auth ───────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=60

# ─── OTP ────────────────────────────────────────────────────
OTP_PEPPER=
# console = codes printed to server logs (dev). WhatsApp provider is added in a later step.
OTP_PROVIDER=console
OTP_TTL_SEC=300
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
OTP_MAX_VERIFY_ATTEMPTS=5

# ─── App Store / Play Store reviewer login ──────────────────
# Fallback only; the live switch is app_config key `auth.demo_login_enabled` (see npm run db:seed).
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_PHONE=919999999999
DEMO_LOGIN_OTP=123456

# ─── Cloudflare R2 (product images) ─────────────────────────
# Leave the four credentials blank to run without image storage; set all four to enable.
# Account ID: Cloudflare dashboard → R2 → right sidebar.
# Keys: R2 → Manage API tokens → "Object Read & Write", scoped to the bucket below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jeya-product-images
# Custom domain (production) or the bucket's r2.dev URL (dev only — rate limited).
R2_PUBLIC_BASE_URL=
